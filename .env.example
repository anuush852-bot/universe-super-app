# Core server
NODE_ENV=production
PORT=3000
DATA_DIR=/data
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
ADMIN_EMAIL=admin@yourdomain.in
ADMIN_PASSWORD=REPLACE_WITH_STRONG_UNIQUE_PASSWORD

# Razorpay Standard Checkout (customer payments and refunds)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxx
RAZORPAY_KEY_SECRET=SET_IN_HOSTING_SECRET_MANAGER
RAZORPAY_WEBHOOK_SECRET=SET_FROM_RAZORPAY_WEBHOOK_CONFIGURATION

# RazorpayX payouts (requires approved account, verified beneficiaries/fund accounts)
RAZORPAYX_KEY_ID=SET_RAZORPAYX_KEY_ID
RAZORPAYX_KEY_SECRET=SET_IN_HOSTING_SECRET_MANAGER
RAZORPAYX_ACCOUNT_NUMBER=SET_VIRTUAL_OR_CURRENT_ACCOUNT_NUMBER
RAZORPAYX_WEBHOOK_SECRET=SET_FROM_RAZORPAYX_WEBHOOK_CONFIGURATION
PAYOUT_AUTO_THRESHOLD=500
MIN_PAYOUT_RUPEES=100

# Commercial rules
SELLER_COMMISSION_PERCENT=10

PARTNER_DELIVERY_EARNING=30
